{
  "manifest_version": 3,
  "name": "Companion4SN",
  "version": "2.0",
  "description": "Advanced live-instance developer toolkit.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.service-now.com/*"
  ],
  "action": {
    "default_title": "Open Companion4SN",
    "default_popup": "dashboard.html"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}