{
  "manifest_version": 3,
  "name": "Scaler by P4",
  "version": "2.0",
  "description": "Advanced live-instance developer toolkit.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.service-now.com/*"
  ],
  "action": {
    "default_title": "Open SNOW Companion",
    "default_popup": "dashboard.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["templates/ServiceNow_Bulk_Catalog_Items_Template.xlsx"],
      "matches": ["*://*.service-now.com/*"]
    }
  ]
}